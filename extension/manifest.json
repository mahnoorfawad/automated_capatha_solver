{
  "manifest_version": 3,
  "name": "AI Captcha Solver (Ollama / Hugging Face)",
  "short_name": "AI Captcha Solver",
  "version": "1.0.0",
  "description": "Solves text, math, reCAPTCHA, hCaptcha and visual captchas using a local Ollama vision model or a free Hugging Face model.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI Captcha Solver",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "webNavigation", "activeTab", "clipboardWrite", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/shared/defaults.js",
        "src/content/common.js",
        "src/content/text-captcha.js",
        "src/content/math-captcha.js",
        "src/content/recaptcha.js",
        "src/content/hcaptcha.js",
        "src/content/turnstile.js",
        "src/content/visual.js"
      ]
    }
  ],
  "commands": {
    "solve-captcha": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Solve captchas on this page"
    },
    "visual-solve": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Visual solve (screenshot + AI)"
    }
  }
}
